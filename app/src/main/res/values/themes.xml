<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; the window theme only sets the background shown before the first frame. -->
    <style name="Theme.GoalKeeper" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/midnight</item>
    </style>

    <style name="Theme.GoalKeeper.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/midnight</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.GoalKeeper</item>
    </style>
</resources>
